#!/bin/sh
# ack, kept as a name and nothing more.
#
# This was a 160 KB vendored Perl script. It had lost its executable bit, so the
# only thing it did was make zsh answer "permission denied" — which reads like a
# broken machine rather than a missing tool. ripgrep does the same job, is what
# the rest of the tooling already reaches for, and is present on every box here.
#
# Flags are passed straight through, so ack's Perl-specific options are gone; the
# common shapes (`ack pattern`, `ack pattern path`, -i, -w, -l, -n) are identical.
for bin in rg ag; do
    if command -v "$bin" >/dev/null 2>&1; then
        exec "$bin" "$@"
    fi
done
echo "ack: needs ripgrep (rg) or the silver searcher (ag) on PATH" >&2
exit 127
